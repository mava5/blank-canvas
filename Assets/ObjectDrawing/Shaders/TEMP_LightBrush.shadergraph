    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Data_Packing",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "uint isErasing = IsErasing ? 1U : 0U;\nuint color = (uint)clamp(ColorIndex, 0, 7.0);\nuint amount = (uint)(saturate(Amount) * 31.0);\n\nuint packed = (isErasing << 8) | (color << 5) | amount;\nfloat b = (float)(packed / 65535.0);\n\nData = float3(0, 0, b);"
}

