            "m_Id": "4c5a3f4e342c4c6d80b69af900a50d36"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Data_Unpacking",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "uint data = (uint)(saturate(Data) * 255.0);\n\nuint color = (data >> 5) & 0x7;\nuint amount = data & 0x1F;\n\nColorIndex = (float)color;\nAmount = (float)amount / 31.0;"
}

