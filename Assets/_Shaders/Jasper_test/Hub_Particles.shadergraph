{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "b2a158aa18cf43d39935bd6ff7c96b78",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Packing (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -801.0001220703125,
            "y": -213.00001525878907,
            "width": 199.0001220703125,
            "height": 93.99999237060547
        }
    },
    "m_Slots": [
        {
            "m_Id": "651e6d23b2954f64a2632a10ab3073b9"
        },
        {
            "m_Id": "0e0712be249740d89bf08ab6bbe5fc52"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Packing",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "    // Clamp and convert to integer ranges\r\n    uint r = (uint)round(saturate(rgb.r) * 31.0); // 5 bits\r\n    uint g = (uint)round(saturate(rgb.g) * 63.0); // 6 bits\r\n    uint b = (uint)round(saturate(rgb.b) * 31.0); // 5 bits\r\n\r\n    // Pack into 16 bits: RRRRRGGGGGGBBBBB\r\n    uint packed16 = (r << 11) | (g << 5) | b;\r\n\r\n    // Split into two bytes\r\n    uint lo = packed16 & 0xFF;\r\n    uint hi = (packed16 >> 8) & 0xFF;\r\n\r\n    // Normalize to 0–1 for RG channels\r\n    packedRG = float2(lo, hi) / 255.0;"
}

