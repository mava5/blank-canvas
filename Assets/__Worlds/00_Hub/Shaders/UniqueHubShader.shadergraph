    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Rect_UV",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 rectScale = RectData.xy;\nfloat2 rectOffset = RectData.zw;\nfloat2 mappedUV = rectOffset + UV * rectScale;\nNewUV = clamp(mappedUV, rectOffset, rectOffset + rectScale);"
}

